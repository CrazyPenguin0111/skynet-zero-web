<Project Sdk="Microsoft.NET.Sdk.Razor">
<PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><AllowMissingPrunePackageData>true</AllowMissingPrunePackageData><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><UseAppHost>false</UseAppHost><RootNamespace>SkynetZero.Web</RootNamespace><DefineConstants>ENGINE_TESTS</DefineConstants><NoWarn>$(NoWarn);CS0649</NoWarn></PropertyGroup>
<ItemGroup>
<FrameworkReference Include="Microsoft.AspNetCore.App" />
<RazorComponent Include="../engine/*.razor" Link="%(Filename)%(Extension)" />
<Compile Include="../engine/App.razor.cs" />
<Compile Include="../engine/OpeningRepertoire.cs" />
<EmbeddedResource Include="../engine/Resources/openings.json" LogicalName="SkynetZero.Openings.json" Condition="Exists('../engine/Resources/openings.json')" />
<Compile Include="../engine/Vendor/*.cs;../engine/Globals.cs;../engine/PortableModel.cs;../engine/Contracts.cs;../engine/GameSession.cs;../engine/EngineBridge.cs" />
<EmbeddedResource Include="../engine/Model/weights.json" LogicalName="SkynetZero.Model.json"/>
<EmbeddedResource Include="../engine/Resources/fsac_table.bin" LogicalName="SkynetZero.SacrificeTable.bin"/>
<EmbeddedResource Include="../engine/Resources/evaluation-tables.bin" LogicalName="SkynetZero.LearnedTables.bin"/>
<None Include="../engine/Model/parity-vectors.json" Link="parity-vectors.json" CopyToOutputDirectory="PreserveNewest"/>
</ItemGroup>
</Project>
