# Copy to /etc/skynetzero/platform.env, owned by root:root, mode 0600.
AllowedHosts=play.5dchess.net;localhost;127.0.0.1
TrustedProxy=127.0.0.1
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft=Warning
# Configure in the Discord developer portal. Do not commit the real secret.
# Redirect: https://play.5dchess.net/signin-discord
Discord__ClientId=
Discord__ClientSecret=
# Optional comma-separated Discord user IDs whose verified logins grant admin.
# Alternatively use the --grant-admin operator command after registration.
AdminDiscordIds=
