<div class="multiverse-viewport" tabindex="0" aria-label="Multiverse chess boards. Drag the background or hold WASD to pan; scroll to zoom.">
@if (Position is not null)
{
    const int cell=36;var zoom=Cell/36d;
    var allBoards=ShowChecks&&Position.CheckPreview is {} preview?preview.Boards:Position.Boards;
    bool compact=ViewMode!="normal",parallel=ViewMode=="parallel";
    bool perspective=Selected?.White??(ShowChecks?!Position.White:Position.White);
    var boards=compact?allBoards.Where(b=>b.White==perspective).ToArray():allBoards;
    var minHalf=allBoards.Min(b=>b.Time*2+(b.White?0:1));
    var maxHalf=allBoards.Max(b=>b.Time*2+(b.White?0:1));
    var minLayer=allBoards.Min(b=>b.Layer);var maxLayer=allBoards.Max(b=>b.Layer);
    var boardWidth=allBoards.Max(b=>b.Width)*cell+26;var boardHeight=allBoards.Max(b=>b.Height)*cell+26;
    var pitch=Math.Max(boardWidth+100,allBoards.Max(b=>b.Height)*cell+126);var row=pitch;
    double Column(int half)=>(half-minHalf)/(compact?2d:1d);
    double Left(int half,int layer)=>80+(parallel?maxLayer-layer:Column(half))*pitch;
    double Top(int half,int layer)=>80+(parallel?Column(half):maxLayer-layer)*row;
    var width=Math.Max(800,(parallel?maxLayer-minLayer+1:Column(maxHalf)+1)*pitch+100);
    var height=Math.Max(460,(parallel?Column(maxHalf)+1:maxLayer-minLayer+1)*row+85);
    var present=allBoards.Where(b=>b.Frontier&&b.Active).Min(b=>b.Time*2+(b.White?0:1));
    var gridLeft=80-(pitch-boardWidth)/2;
    var travelMoves=TravelArrows().ToArray();
    double BoardCenterY(int half,int layer)=>Top(half,layer)+32+boardHeight/2d;
    double X(Square s)=>Left(s.T*2+(s.White?0:1),s.L)+13+(Flipped?allBoards[0].Width-1-s.X:s.X)*cell+cell/2d;
    double Y(Square s)=>Top(s.T*2+(s.White?0:1),s.L)+45+(Flipped?s.Y:allBoards[0].Height-1-s.Y)*cell+cell/2d;
    var annotation=AnnotationSquare();
    <div class="multiverse-space @(AnimateTravel?"animate-travel":"") view-@ViewMode" style="--full-turn:@(pitch*(compact?1:2)*zoom)px;--timeline-row:@(row*zoom)px;--turn-left:@((gridLeft+(minHalf%2!=0&&!compact?pitch:0))*zoom)px;--grid-top:@((BoardCenterY(minHalf,maxLayer)-row/2d)*zoom)px">
    @* The band belongs to the scroll space, outside the scaled canvas. It
       covers the entire padded view at every zoom without changing its bounds. *@
    <div class="present-line @(present%2==0?"white":"black") @(parallel?"parallel":"")" aria-label="Present" style="@(parallel?$"top:calc(50vh + {BoardCenterY(present,maxLayer)*zoom}px);height:{boardHeight*.76*zoom}px":$"left:calc(50vw + {(Left(present,maxLayer)+boardWidth/2d)*zoom}px);width:{boardWidth*.76*zoom}px");--band-border:@(4*zoom)px;--band-shadow:@(-9*zoom)px"></div>
    <div class="multiverse-scale" style="width:@(width*zoom)px;height:@(height*zoom)px">
    <div class="multiverse-canvas" data-zoom="@zoom" style="width:@(width)px;height:@(height)px;--cell:@(cell)px;transform:scale(@zoom)">
        @for(int layer=maxLayer;layer>=minLayer;layer--)
        {
            var l=layer;var branch=Position.Branches.FirstOrDefault(b=>b.Layer==l);
            var start=branch is null?12:80+Column(branch.StartTime*2+(branch.StartWhite?0:1))*pitch;
            <div class="timeline-line @(parallel?"parallel":"")" style="left:@(parallel?Left(minHalf,l)+boardWidth/2d+48:start)px;top:@(parallel?start:BoardCenterY(minHalf,l)-48)px;width:@((parallel?height:width)-start-96)px" aria-hidden="true">@if(branch is null){<span>@LayerLabel(l)</span>}<i></i></div>
        }
        <svg class="branch-connectors" width="@width" height="@height" aria-label="Timeline ancestry">
        @foreach(var branch in Position.Branches)
        {
            int parentHalf=branch.ParentTime*2+(branch.ParentWhite?0:1),childHalf=branch.StartTime*2+(branch.StartWhite?0:1);
            var fromX=Left(parentHalf,branch.ParentLayer)+(parallel?boardWidth/2d:boardWidth);
            var toX=Left(childHalf,branch.Layer)+(parallel?boardWidth/2d:0);
            var fromY=parallel?Top(parentHalf,branch.ParentLayer)+32+boardHeight:BoardCenterY(parentHalf,branch.ParentLayer);
            var toY=parallel?Top(childHalf,branch.Layer)+32:BoardCenterY(childHalf,branch.Layer);
            var midX=(fromX+toX)/2d;var midY=(fromY+toY)/2d;
            <g><title>@LayerLabel(branch.Layer) branched from @LayerLabel(branch.ParentLayer) at T@(branch.ParentTime), @(branch.ParentWhite?"White":"Black")</title>
                <path d="@(parallel?$"M {fromX},{fromY} C {fromX},{midY} {toX},{midY} {toX},{toY}":$"M {fromX},{fromY} C {midX},{fromY} {midX},{toY} {toX},{toY}")"/>
                <circle cx="@fromX" cy="@fromY" r="12"/>
            </g>
        }
        </svg>
        @foreach(var board in boards.OrderBy(b=>b.Time).ThenBy(b=>b.White))
        {
            var half=board.Time*2+(board.White?0:1);var left=Left(half,board.Layer);var top=Top(half,board.Layer);
            var origin=Position.Branches.FirstOrDefault(b=>b.Layer==board.Layer&&b.StartTime==board.Time&&b.StartWhite==board.White);
            <section @key="(board.Layer,board.Time,board.White)" class="board @(board.White?"white-turn":"black-turn") @(board.Frontier?"frontier":"historical") @(board.Active?"active":"inactive") @(board.Frontier&&board.White==Position.White?"to-move playable":"") @(board.Frontier&&board.Active&&half==present?"present":"")" style="left:@(left)px;top:@(top)px;width:@(board.Width*cell+26)px" aria-label="Timeline @LayerLabel(board.Layer), turn @board.Time, @(board.White?"White":"Black")">
                @if(IsCheckBoard(board)){<button class="check-indicator board-check" @onclick="()=>OnCheck.InvokeAsync()" aria-label="@(ShowChecks?"Hide checks":"Show checks")" aria-pressed="@(ShowChecks?"true":"false")" title="@(Position.Status=="Checkmate"?"Checkmate · show checks":"Check · show checks")">!</button>}
                @if(origin is not null){<div class="branch-source">Branched from @LayerLabel(origin.ParentLayer) · T@(origin.ParentTime) @(origin.ParentWhite?"White":"Black")</div>}
                <header class="board-caption"><span><i class="side-dot @(board.White?"white":"black")"></i> T@(board.Time)</span></header>
                <div class="board-frame"><div class="squares" role="grid" style="grid-template-columns:repeat(@board.Width,var(--cell))">
                @for(int rank=0;rank<board.Height;rank++)
                {
                    var y=Flipped?rank:board.Height-1-rank;
                    @for(int file=0;file<board.Width;file++)
                    {
                        var x=Flipped?board.Width-1-file:file;var square=new Square(x,y,board.Time,board.Layer,board.White);
                        var piece=board.Pieces[y*board.Width+x];var selected=Selected==square;
                        var destination=!ShowChecks&&Selected is not null&&Position.LegalMoves.Any(m=>m.From==Selected&&m.To==square);
                        var last=LastMoves.Any(m=>m.From==square||m.To==square);
                        <button type="button" role="gridcell" class="square @((x+y)%2==0?"dark":"light") @(selected?"selected":"") @(destination?"destination":"") @(last?"last-move":"")" @onclick="()=>OnSquare.InvokeAsync(square)" disabled="@ShowChecks" aria-label="@SquareLabel(square,piece)" aria-selected="@selected" title="@SquareLabel(square,piece)">
                            @if(piece!=0){<img class="piece" src="@PieceImage(piece)" alt="@PieceName(piece)" draggable="false"/> @if(IsFairy(piece)){<span class="fairy-badge">@PieceLetter(piece)</span>}}
                            @if(destination){<span class="move-dot"></span>}
                            @if(annotation==square&&Analysis is {} review){<span class="square-review"><MoveBadge Category="@review.Category" Label="@review.Verdict" Description="@review.Description"/></span>}
                            else if(annotation==square&&Position.Turns.FirstOrDefault(t=>t.Index==Position.Viewing)?.BookName is {} opening){<span class="square-review"><MoveBadge Category="book" Label="Book" Description="@opening"/></span>}
                            @if(file==0){<span class="rank-label">@(y+1)</span>}
                            @if(rank==board.Height-1){<span class="file-label">@((char)('a'+x))</span>}
                        </button>
                    }
                }
                </div></div>
                <footer><span>@LayerLabel(board.Layer)</span></footer>
            </section>
        }
        @if(travelMoves.Length>0)
        {
            <svg class="travel-overlay" width="@width" height="@height" aria-label="Played time-travel moves"><defs>
                <marker id="travel-white" markerWidth="7" markerHeight="7" refX="5" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 Z" fill="#f6f4eb" stroke="#262b30" stroke-width=".4"/></marker>
                <marker id="travel-black" markerWidth="7" markerHeight="7" refX="5" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 Z" fill="#161a20" stroke="#d8dde5" stroke-width=".4"/></marker>
            </defs>
            @foreach(var move in travelMoves)
            {
                var path=$"M {X(move.From)},{Y(move.From)} Q {(X(move.From)+X(move.To))/2},{Math.Min(Y(move.From),Y(move.To))-85} {X(move.To)},{Y(move.To)}";
                <path d="@path" fill="none" stroke="@(move.White?"#262b30":"#d8dde5")" stroke-width="7"/>
                <path class="played-travel @(move.White?"white":"black")" d="@path" fill="none" stroke="@(move.White?"#f6f4eb":"#161a20")" stroke-width="4" marker-end="url(#travel-@(move.White?"white":"black"))"><title>@move.Notation</title></path>
            }
            </svg>
        }
        @if(ShowChecks&&Position.CheckPreview is {} checks)
        {
            <svg class="check-overlay" width="@width" height="@height" aria-label="Attacks checking royal pieces">
                <defs><marker id="check-arrow" markerWidth="7" markerHeight="7" refX="5" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 Z" fill="#ff424c"/></marker></defs>
                @foreach(var check in checks.Checks)
                {
                    <circle class="checked-royal" cx="@X(check.To)" cy="@Y(check.To)" r="@(cell*.43)"/>
                    <path class="check-arrow" d="M @X(check.From),@Y(check.From) L @X(check.To),@Y(check.To)" marker-end="url(#check-arrow)"><title>Check from @SquareLabel(check.From,0) to @SquareLabel(check.To,0)</title></path>
                }
            </svg>
        }
    </div>
    </div>
    </div>
}
</div>
@code {
 [Parameter]public PositionView? Position{get;set;}
 [Parameter]public Square? Selected{get;set;}
 [Parameter]public bool Flipped{get;set;}
 [Parameter]public bool ShowChecks{get;set;}
 [Parameter]public int Cell{get;set;}=36;
 [Parameter]public MoveView[] LastMoves{get;set;}=[];
 [Parameter]public EventCallback<Square> OnSquare{get;set;}
 [Parameter]public EventCallback OnCheck{get;set;}
 [Parameter]public TurnAnalysis? Analysis{get;set;}
 [Parameter]public string ViewMode{get;set;}="normal";
 [Parameter]public bool AnimateTravel{get;set;}=true;
 private Square? AnnotationSquare(){
    var turn=Position?.Turns.FirstOrDefault(t=>t.Index==Position.Viewing);
    if(turn?.Moves.LastOrDefault() is not {} move)return null;
    var branch=Position!.Branches.FirstOrDefault(b=>b.Turn==turn.Index&&b.Action==turn.Moves.Length);
    return move.To with { L=branch?.Layer??move.To.L,T=branch?.StartTime??move.To.T+(move.To.White?0:1),White=branch?.StartWhite??!move.To.White };
 }
 private bool IsCheckBoard(BoardView board){
    if(Position is not {InCheck:true,CheckPreview:not null})return false;
    var moves=Position.Pending.Length>0?Position.Pending:Position.Turns.FirstOrDefault(t=>t.Index==Position.Viewing)?.Moves??[];
    if(moves.LastOrDefault() is {} move){
        var arrival=AnnotationSquare();
        bool branchChecks=arrival is not null&&arrival.L!=move.From.L&&Position.CheckPreview.Checks.Any(c=>c.From.L==arrival.L);
        int layer=branchChecks?arrival!.L:move.From.L,time=branchChecks?arrival!.T:move.From.T+(move.From.White?0:1);
        bool white=branchChecks?arrival!.White:!move.From.White;
        return board.Layer==layer&&board.Time==time&&board.White==white;
    }
    // A custom initial position may already be checked without a played move.
    return Position.Boards.Any(b=>b.Frontier&&b.Active&&b.Layer==board.Layer&&b.Time==board.Time&&b.White==board.White)&&
        Position.CheckPreview.Checks.Any(c=>c.To.L==board.Layer);
 }
 private sealed record TravelArrow(Square From,Square To,string Notation,bool White);
 private IEnumerable<TravelArrow> TravelArrows() {
    if(Position is null)yield break;
    var moves=Position.Turns.Where(t=>t.Index<=Position.Viewing)
        .SelectMany(t=>t.Moves.Select((move,index)=>(Move:move,Turn:t.Index,Action:index+1)))
        .Concat(Position.Pending.Select((move,index)=>(Move:move,Turn:Position.TurnCount+1,Action:index+1)));
    foreach(var item in moves) {
        var move=item.Move;
        if(move.From.L==move.To.L&&move.From.T==move.To.T)continue;
        // The piece travels to the original target in history. The separate
        // ancestry connector shows the resulting new timeline.
        yield return new(move.From,move.To,move.Notation,Math.Abs(move.Piece)<=12);
    }
 }
 private string LayerLabel(int layer)=>Position?.Even==true?(layer<=0?$"L −{-layer}":$"L +{layer-1}"):$"L {(layer>0?"+":"")}{layer}";
 public static int Kind(int piece)=>(Math.Abs(piece)-1)%12+1;
 public static bool IsFairy(int piece)=>Kind(piece) is 5 or >=8;
 public static char PieceLetter(int piece)=>Board.PieceChars[Math.Abs(piece)];
 public static string PieceImage(int piece)=>$"pieces/{(Math.Abs(piece)<=12?'w':'b')}{(Kind(piece) switch{1 or 10=>'P',2 or 8=>'N',3 or 9=>'B',4=>'R',5 or 6 or 11=>'Q',_=>'K'})}.svg";
 public static string PieceName(int piece)=>(Math.Abs(piece)<=12?"White ":"Black ")+(Kind(piece) switch{1=>"pawn",2=>"knight",3=>"bishop",4=>"rook",5=>"princess",6=>"queen",7=>"king",8=>"unicorn",9=>"dragon",10=>"brawn",11=>"royal queen",_=>"common king"});
 private static string SquareLabel(Square s,int piece)=>$"{(char)('a'+s.X)}{s.Y+1}, {(piece==0?"empty":PieceName(piece))}, timeline {s.L}, T{s.T} {(s.White?"white":"black")}";
}
