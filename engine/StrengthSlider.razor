@namespace SkynetZero.Web
<div class="strength-picker">
    <div class="strength-label"><label for="@Id">@Label</label><output for="@Id">@Value <span>/ 100</span></output></div>
    <input id="@Id" type="range" min="@Minimum" max="100" step="1" value="@Value" @oninput="Change" disabled="@Disabled"
           aria-valuetext="Level @Value of 100" aria-describedby="@(Id+"-hint")"/>
    <div class="strength-scale" aria-hidden="true"><span>@(Minimum>1?$"Minimum {Minimum}":"Casual")</span><span>Maximum</span></div>
    <small id="@(Id+"-hint")">@((Strength.FromLevel(Value).Milliseconds/1000d).ToString("0.0",CultureInfo.InvariantCulture)) second @(PerPosition?"budget per position":"search budget")</small>
</div>
@code {
    [Parameter,EditorRequired] public string Id {get;set;}="strength";
    [Parameter] public string Label {get;set;}="Engine strength";
    [Parameter] public int Value {get;set;}=Strength.Default;
    [Parameter] public EventCallback<int> ValueChanged {get;set;}
    [Parameter] public bool Disabled {get;set;}
    [Parameter] public bool PerPosition {get;set;}
    [Parameter] public int Minimum {get;set;}=Strength.Minimum;
    private Task Change(ChangeEventArgs e)=>int.TryParse(e.Value?.ToString(),out int level)
        ?ValueChanged.InvokeAsync(Math.Clamp(level,Minimum,Strength.Maximum)):Task.CompletedTask;
}
