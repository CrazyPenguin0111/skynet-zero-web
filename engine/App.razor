@namespace SkynetZero.Web
@inject IJSRuntime JS
<div class="app-shell" tabindex="-1">
    <header class="app-header">
        <a class="brand" href="./" aria-label="SkynetZero home"><span class="logo-mark">S<span>0</span></span><span>SKYNET<span class="brand-zero">ZERO</span><small>MULTIVERSE CHESS</small></span></a>
        <nav class="top-nav" aria-label="Main navigation"><button class="@(!_review?"current":"")" @onclick="PlayMode">Play</button><button class="@(_review?"current":"")" @onclick="ReviewMode">Analysis board</button></nav>
        <button class="help-button" title="How to play" aria-label="How to play" @onclick="()=>_help=true">?</button>
    </header>
    <div class="game-layout">
        <main class="workspace">
            <div class="workspace-heading"><div><div class="eyebrow">@(_review?"EXPLORE EVERY POSSIBILITY":"A MOVE BEYOND THE PRESENT")</div><h1>@(_review?"Game analysis":"Your move. Across time.")</h1></div><div class="view-tools"><button @onclick="()=>_flipped=!_flipped" title="Flip boards" aria-label="Flip boards">⇅</button><button @onclick="FocusPresent" title="Focus the present" aria-label="Focus the present">⊙</button><label title="Board zoom"><span>−</span><input aria-label="Board zoom" type="range" min="24" max="52" step="2" @bind="_cell"/><span>+</span></label></div></div>
            @if(!string.IsNullOrEmpty(_error)){<div class="notice error" role="alert">@_error <button aria-label="Dismiss error" @onclick="()=>_error=null">×</button></div>}
            @if(!string.IsNullOrEmpty(_message)){<div class="notice" role="status">@_message <button aria-label="Dismiss message" @onclick="()=>_message=null">×</button></div>}
            @if(_showChecks){<div class="notice check-preview-notice" role="status"><span>Showing checks · present boards advanced one move</span><button @onclick="ToggleChecks">Return to position</button></div>}
            @if(_position is null){<div class="engine-loading"><div class="spinner"></div><h2>Preparing the multiverse</h2><p>Loading SkynetZero…</p>@if(_error!=null){<button @onclick="Initialize">Retry engine</button>}</div>}
            else {
                <Multiverse Position="_position" Selected="_selected" Cell="_cell" Flipped="_flipped" LastMoves="LastMoves" ShowChecks="_showChecks" OnSquare="SelectSquare"/>
                <div class="workspace-footer"><div class="legend"><span><i class="legend-present"></i> Present</span><span><i class="legend-timeline"></i> Timeline</span><span><i class="legend-history"></i> History</span></div><span class="pan-hint">WASD to pan · F to submit</span></div>
                <div class="turn-bar"><div class="turn-indicator"><img class="turn-piece" src="@(_position.White?"pieces/wK.svg":"pieces/bK.svg")" alt="@(_position.White?"White to move":"Black to move")"/>@if(_position.InCheck){<button class="check-indicator" @onclick="ToggleChecks" aria-label="@(_showChecks?"Hide checks":"Show checks")" aria-pressed="@(_showChecks?"true":"false")" title="@(_position.Status=="Checkmate"?"Checkmate · show checks":"Check · show checks")">!</button>}<div><strong>@StatusTitle</strong><small>@StatusDetail</small></div></div><div class="turn-actions">
                @if(_busy){<button class="cancel-button" @onclick="Cancel">Stop</button><span class="thinking"><i class="spinner small"></i>@_activity</span>}
                else if(_showChecks){<button class="button primary" @onclick="ToggleChecks">Return to position</button>}
                else if(_review){<button class="button primary" @onclick="AnalyzePosition">Analyze position <span>↗</span></button>}
                else if(_position.Result!="*"){<button class="button primary" @onclick="ReviewMode">Review game <span>↗</span></button>}
                else if(_viewIndex<_position.TurnCount){<button class="button primary" @onclick="GoLive">Return to game ⟶</button>}
                else if(IsEngineTurn){<button class="button primary" @onclick="EngineMove">Let engine move <span>↗</span></button>}
                else {<button class="button quiet" disabled="@(_position.PendingCount==0)" @onclick="Undo">↶ Undo</button><button class="button submit" disabled="@(!CanSubmitTurn)" @onclick="Submit">Submit turn <kbd>F</kbd></button>}
                </div></div>
            }
        </main>
        <aside class="sidebar">
            <div class="opponent"><div class="engine-avatar">S<span>0</span></div><div><span class="eyebrow">YOUR OPPONENT</span><h2>SkynetZero</h2><span class="model-label">v10 · Promoted epoch 1,040</span></div></div>
            <div class="sidebar-strength"><StrengthSlider Id="strength" @bind-Value="_strength" Disabled="_busy"/>@if(_lastSearch is {} search){<small class="last-search">Last search: @(search.StaticOnly?"no depth completed":$"depth {search.Depth}") · @search.Seconds.ToString("0.0")s</small>}</div>
            <div class="panel-tabs"><button class="@(!_review?"selected":"")" @onclick="PlayMode">Moves</button><button class="@(_review?"selected":"")" @onclick="ReviewMode">Analysis</button><button class="icon-button" title="Import 5DPGN" aria-label="Import 5DPGN" @onclick="()=>_importOpen=true">↥</button></div>
            @if(_review){
                <div class="evaluation"><div><span class="eyebrow">POSITION EVALUATION</span><strong class="score">@(SelectedEvaluation?.Display??"—")</strong></div><span class="eval-perspective">@(SelectedEvaluation?.Mate!=null?SelectedEvaluation.Winner==true?"White mates":"Black mates":"White’s perspective")</span><div class="eval-track"><div style="width:@(EvalPercent.ToString("0.0",CultureInfo.InvariantCulture))%"></div></div><small>@(SelectedEvaluation?.Explanation??"Run analysis to evaluate this position")</small></div>
                @if(_evaluations.Count>0){
                    <svg class="evaluation-chart" viewBox="0 0 300 78" role="img" aria-label="Evaluation by complete turn, shaded white for White advantage and black for Black advantage">
                    <defs><clipPath id="white-advantage"><rect x="0" y="0" width="300" height="39"/></clipPath><clipPath id="black-advantage"><rect x="0" y="39" width="300" height="39"/></clipPath></defs>
                    <path class="eval-area white" d="@ChartAreaPath" fill="#fffef8" clip-path="url(#white-advantage)"/>
                    <path class="eval-area black" d="@ChartAreaPath" fill="#26333c" fill-opacity=".8" clip-path="url(#black-advantage)"/>
                    <line x1="0" x2="300" y1="39" y2="39" stroke="#a6afa4" stroke-dasharray="3 4"/><path d="@ChartPath" stroke="#437c76" stroke-width="2" fill="none"/>
                    @foreach(var e in _evaluations.Values.OrderBy(v=>v.Index)){var point=e;<circle cx="@ChartX(point.Index)" cy="@ChartY(point)" r="@(point.Index==_viewIndex?4:2)" fill="#437c76" @onclick="()=>Navigate(point.Index)"/>}
                    </svg>
                }
                <div class="acpl-grid"><div><span>White ACPL</span><strong>@AverageLoss(true)</strong></div><div><span>Black ACPL</span><strong>@AverageLoss(false)</strong></div></div>
                <div class="analysis-actions"><StrengthSlider Id="analysis-strength" Label="Analysis strength" Value="_analysisLevel" ValueChanged="SetAnalysisLevel" Minimum="AnalysisMinimum" Disabled="_busy" PerPosition="true"/>@if(!_analysisComplete){<button class="button dark" @onclick="AnalyzeGame" disabled="@(_busy||_position is null||_position.TurnCount==0)">@(_analyzing?$"Analyzing {_analysisDone}/{_position!.TurnCount+1}":"Analyze whole game")</button>}</div>
            }
            <div class="moves-heading"><span>TURN</span><span>@(_review?"MOVE / CENTIPAWN LOSS":"GAME NOTATION")</span><span>@(_position?.TurnCount??0)</span></div>
            <div class="moves-list" aria-label="Game moves">
            @if(_position is not null){
                @if(_position.Turns.Length==0){<div class="empty-moves"><span>♘</span><strong>Every timeline starts here.</strong><p>Make your first move, or import a 5DPGN game to explore.</p></div>}
                @foreach(var turn in _position.Turns){var t=turn;var a=_analysis.GetValueOrDefault(t.Index);<button class="move-row @(t.Index==_viewIndex?"active":"")" @onclick="()=>Navigate(t.Index)" disabled="@_busy"><span class="move-number">@t.Index<i class="side-dot @(t.White?"white":"black")"></i></span><span class="move-notation">@t.Notation @if(_review&&a!=null){<small class="verdict @(a.Loss>=100?"mistake":"")">@a.Verdict</small>}</span>@if(_review&&a!=null){<span class="loss @(a.Loss>=100?"mistake":"")">@(a.Loss is {} loss?$"{loss} cp":a.After.Display)</span>}</button>}
                @if(_position.PendingCount>0){<div class="pending-moves"><span>PENDING TURN</span>@string.Join(" · ",_position.Pending.Select(m=>m.Notation))</div>}
            }</div>
            <div class="history-controls"><button title="First position" aria-label="First position" disabled="@_busy" @onclick="()=>Navigate(0)">|‹</button><button title="Previous turn" aria-label="Previous turn" disabled="@(_busy||_viewIndex==0)" @onclick="()=>Navigate(_viewIndex-1)">‹</button><span>@_viewIndex / @(_position?.TurnCount??0)</span><button title="Next turn" aria-label="Next turn" disabled="@(_busy||_viewIndex>=(_position?.TurnCount??0))" @onclick="()=>Navigate(_viewIndex+1)">›</button><button title="Live position" aria-label="Live position" disabled="@_busy" @onclick="GoLive">›|</button></div>
            @if(_review&&SelectedEvaluation is {BestTurn.Length:>0} ev){<div class="best-line"><span class="eyebrow">@(ev.StaticOnly?"LEGAL FALLBACK":"ENGINE’S BEST TURN")</span><p>@ev.BestTurn</p></div>}
            <div class="sidebar-bottom"><button class="button outline" disabled="@_busy" @onclick="()=>_newOpen=true">＋ New game</button><button class="button outline" disabled="@(_position is null)" @onclick="Export">Export 5DPGN ↧</button><div class="minor-actions"><button @onclick="()=>_importOpen=true">Import 5DPGN</button>@if(!_review&&_position?.Result=="*"){<button @onclick="()=>_resignOpen=true" disabled="@_busy">Resign</button>}<button @onclick="()=>_help=true">About & controls</button></div></div>
        </aside>
    </div>
    <footer class="app-footer"><span>SPACE. TIME. YOUR NEXT MOVE.</span><span><a href="https://github.com/CrazyPenguin0111/skynet-zero-web" target="_blank" rel="noreferrer">Source ↗</a></span></footer>
</div>
@if(_importOpen){<div class="modal-backdrop"><section class="modal" role="dialog" aria-modal="true" aria-labelledby="import-title"><button class="modal-close" aria-label="Close import" @onclick="()=>_importOpen=false">×</button><span class="eyebrow">BRING YOUR OWN TIMELINES</span><h2 id="import-title">Import a game</h2><p>Paste 5DPGN or open a file.</p><label class="file-input">Open .5dpgn file<InputFile OnChange="ReadPgnFile" accept=".5dpgn,.pgn5,.pgn,.txt"/></label><textarea aria-label="5DPGN game" @bind="_importText" placeholder="[Board &quot;standard&quot;]&#10;1. (0T1)e4 / (0T1)e5"></textarea>@if(_importError!=null){<p class="form-error" role="alert">@_importError</p>}<div class="modal-actions"><button class="button quiet" @onclick="LoadExample">Load time-travel example</button><button class="button dark" disabled="@(_busy||string.IsNullOrWhiteSpace(_importText))" @onclick="Import">Open analysis board ⟶</button></div></section></div>}
@if(_newOpen){<div class="modal-backdrop"><section class="modal compact" role="dialog" aria-modal="true" aria-labelledby="new-title"><button class="modal-close" aria-label="Close new game" @onclick="()=>_newOpen=false">×</button><span class="eyebrow">A FRESH POSSIBILITY</span><h2 id="new-title">New game</h2><p>Your current game will be replaced. Export it first if you’d like to keep it.</p><label>Play as<select @bind="_newSide"><option value="white">White · move first</option><option value="black">Black · engine moves first</option><option value="random">Random side</option></select></label><label>Starting board<select @bind="_variant"><option value="standard-t0">Standard with turn zero</option><option value="standard">Standard</option></select></label><StrengthSlider Id="new-strength" @bind-Value="_strength" Disabled="_busy"/><button class="button dark full" @onclick="NewGame">Start game ⟶</button></section></div>}
@if(_resignOpen){<div class="modal-backdrop"><section class="modal compact" role="dialog" aria-modal="true" aria-labelledby="resign-title"><h2 id="resign-title">Resign this game?</h2><p>You can review and export the game afterward.</p><div class="modal-actions"><button class="button quiet" @onclick="()=>_resignOpen=false">Keep playing</button><button class="button dark" @onclick="Resign">Resign</button></div></section></div>}
@if(_promotions.Length>0){<div class="modal-backdrop"><section class="modal compact" role="dialog" aria-modal="true" aria-labelledby="promotion-title"><h2 id="promotion-title">Choose your promotion</h2><div class="promotion-options">@foreach(var m in _promotions){var move=m;<button @onclick="()=>MakeMove(move)"><img src="@Multiverse.PieceImage(move.Promotion)" alt=""/>@Multiverse.PieceName(move.Promotion)</button>}</div><button class="button quiet" @onclick="()=>_promotions=[]">Cancel</button></section></div>}
@if(_help){<div class="modal-backdrop"><section class="modal help-modal" role="dialog" aria-modal="true" aria-labelledby="help-title"><button class="modal-close" aria-label="Close help" @onclick="()=>_help=false">×</button><span class="eyebrow">WELCOME TO THE MULTIVERSE</span><h2 id="help-title">Chess, with more possibilities.</h2><p>Select a piece, then a highlighted destination. Destinations may be on a different timeline or in the past. Time travel can create a new timeline.</p><p>Make moves on the required boards until the present advances, then choose <strong>Submit turn</strong> or press <strong>F</strong>. You can undo moves before submitting. Protect your kings across the entire multiverse.</p><p>Use <strong>WASD</strong> or scroll across the canvas to explore. Use the zoom slider, flip button, and present button to change your view. Arrow keys navigate the game; Escape clears your selection.</p><hr/><h3>Reading the analysis</h3><p>Positive scores favor White. One pawn is 100 centipawns, normalized to SkynetZero’s reference pawn coefficient. Centipawn loss measures how much a complete turn worsened the mover’s evaluation. ACPL is the average of scored turns; evaluations are capped at ±1,000 cp for loss calculations. Mate transitions are labeled separately and excluded from ACPL.</p><p><strong>M3</strong> means a proven mate in 3 moves (complete multiverse turns by the winning side). A large advantage or an interrupted search alone is never labeled as mate. These are SkynetZero evaluations, not calibrated Lichess accuracy or Elo ratings.</p><h3>Built from SkynetZero</h3><p>The bundled epoch 1,040 checkpoint was the most recent statistically promoted trained model found when this app was built.</p><p><a href="model-info.json" target="_blank">Model provenance ↗</a> · <a href="https://github.com/CrazyPenguin0111/skynet-zero-web" target="_blank" rel="noreferrer">Source & licenses ↗</a></p><small>Inspired by the timeline interface of 5D Chess With Multiverse Time Travel. An independent project, not affiliated with Thunkspace. Chess pieces by Colin M. L. Burnett, GPL-2.0-or-later.</small></section></div>}
