@namespace SkynetZero.Web
@inject IJSRuntime JS
@implements IAsyncDisposable
@if(!_initialized){<div class="community-loading"><div class="spinner"></div><p>Opening SkynetZero…</p></div>}
else if(!_online){<App/>}
else{
<div class="community-shell">
    <header class="community-header"><a href="#play" class="community-brand">SKYNET<span>ZERO</span><small>5D CHESS</small></a>
        <nav aria-label="Main navigation">@foreach(var item in Nav){<a href="#@item.Route" class="@(_page==item.Route?"active":"")">@item.Label</a>}</nav>
        <a class="account-link" href="#account">@(_session?.User?.Username??"Sign in") <span>↗</span></a>
    </header>
    @if(_error!=null){<div class="community-alert" role="alert">@_error<button @onclick="()=>_error=null" aria-label="Dismiss">×</button></div>}
    @if(_notice!=null){<div class="community-alert success" role="status">@_notice<button @onclick="()=>_notice=null" aria-label="Dismiss">×</button></div>}
    @if(_page=="bot"){<App InitialPgn="@_analysisPgn"/>}
    else if(_page=="game"&&_argument.Length>0){<OnlineBoard @key="_argument" GameId="@_argument" User="_session?.User" OnReview="ReviewGame"/>}
    else{<main class="community-main" aria-busy="@_loading">
    @if(_page=="play"){
        <section class="community-intro"><div><span class="kicker">MORE THAN ONE WAY FORWARD</span><h1>A game across<br/><em>every timeline.</em></h1><p>Play 5D chess with people. Meet your rival twice, once with each color, and find your place in the multiverse.</p><div class="intro-links"><a class="community-button primary" href="#challenge">Create a match <span>↗</span></a><a class="text-link" href="#bot">Play SkynetZero →</a></div></div><div class="time-grid" aria-label="Quick match time controls">@foreach(var control in Presets){var tc=control;<button @onclick="()=>QuickMatch(tc)"><strong>@tc.Label</strong><span>@tc.Category</span></button>}</div></section>
        <div class="community-columns"><section class="community-card"><div class="card-heading"><h2>Open challenges</h2><span class="pill">2 games · swap colors</span></div>
            @if(_lobby?.Challenges.Length>0){<div class="table-scroll"><table><thead><tr><th>Player</th><th>Variant</th><th>Clock</th><th>Mode</th><th></th></tr></thead><tbody>@foreach(var item in _lobby.Challenges){var challenge=item;<tr><td><a href="#player/@challenge.Creator">@challenge.Creator</a></td><td>@VariantName(challenge.Variant)</td><td>@(new TimeControl(challenge.Seconds,challenge.Increment).Label)</td><td>@(challenge.Rated?"Rated":"Casual")</td><td>@if(challenge.Creator==_session?.User?.Username){<button class="small-button" @onclick="()=>CancelChallenge(challenge.Id)">Cancel</button>}else{<button class="small-button green" @onclick="()=>AcceptChallenge(challenge.Id)">Join →</button>}</td></tr>}</tbody></table></div>}
            else{<div class="empty-community"><span>↗</span><h3>The next match starts with you.</h3><p>Create a challenge, or choose a time control above.</p></div>}
        </section><aside class="community-card league-promo"><span class="kicker">5D CHESS LEAGUE</span><h2>Your league.<br/>Your next chapter.</h2><p>Round robin groups matched by league Elo. Two games against every opponent.</p><a class="text-link" href="#league">Explore the league →</a><div class="league-bands"><span>Entry</span><span>Advanced</span><span>Pro</span></div></aside></div>
        @if(_lobby?.Matches.Length>0){<section class="community-card"><div class="card-heading"><h2>Your matches</h2><button class="small-button" @onclick="Refresh">Refresh</button></div><div class="match-list">@foreach(var m in _lobby.Matches){<a href="#match/@m.Id"><span>@m.Player1 <small>vs</small> @m.Player2</span><strong>@m.Score1.ToString("0.#") : @m.Score2.ToString("0.#")</strong><small>@VariantName(m.Variant) · @m.Category · @m.Status</small><span>→</span></a>}</div></section>}
    }
    else if(_page=="challenge"){
        <div class="page-heading"><span class="kicker">PLAY TOGETHER</span><h1>Create a match</h1><p>Two games, opposite colors. The clock starts when both players are ready.</p></div>
        <section class="community-card form-card"><div class="form-grid"><label>Variant<select aria-label="Variant" @bind="_variant">@foreach(var v in _site!.Variants.Where(v=>v.Available)){<option value="@v.Id">@v.Name</option>}</select></label><label>Minutes per player<input type="number" min="0.5" max="180" step="0.5" @bind="_minutes"/></label><label>Increment per complete turn<input type="number" min="0" max="180" @bind="_increment"/><small>Seconds added after submitting a whole turn.</small></label><label>Opponent (optional)<input @bind="_opponent" placeholder="Username or leave open" maxlength="24"/></label></div><div class="choice-row"><label><input type="checkbox" @bind="_rated"/> Rated</label><label><input type="checkbox" @bind="_private"/> Private invite</label><span class="pill">@(new TimeControl((int)(_minutes*60),_increment).Category)</span></div><button class="community-button primary" disabled="@_busy" @onclick="CreateChallenge">Create two-game match →</button>
        @if(_challenge!=null){<div class="share-panel"><p>Challenge ready. Share this invitation with your opponent.</p><input readonly value="@_shareUrl" aria-label="Challenge invitation"/><button class="small-button" @onclick="()=>Copy(_shareUrl)">Copy invitation</button><a href="#invite/@_challenge.Id">View challenge →</a></div>}</section>
    }
    else if(_page=="invite"&&_challenge!=null){
        <section class="community-card invitation"><span class="kicker">YOU’RE INVITED</span><h1>@_challenge.Creator challenges you.</h1><p>@VariantName(_challenge.Variant) · @(new TimeControl(_challenge.Seconds,_challenge.Increment).Label) · @(_challenge.Rated?"Rated":"Casual")</p><p>Two games. One as White, one as Black.</p><button class="community-button primary" disabled="@_busy" @onclick="()=>AcceptChallenge(_challenge.Id)">Accept challenge →</button></section>
    }
    else if(_page=="match"&&_match!=null){
        <div class="page-heading"><span class="kicker">@VariantName(_match.Variant) · @_match.Category · @(_match.Rated?"RATED":"CASUAL")</span><h1>@_match.Player1 <em>vs</em> @_match.Player2</h1><p>@_match.Score1.ToString("0.#") – @_match.Score2.ToString("0.#") · @_match.Status</p></div>
        <div class="game-pair">@for(int i=0;i<_match.Games.Length;i++){int n=i;<a class="community-card game-tile" href="#game/@_match.Games[n]"><span class="kicker">GAME @(n+1)</span><h2>@(n==0?_match.Player1:_match.Player2)<span>White</span></h2><h2>@(n==0?_match.Player2:_match.Player1)<span>Black</span></h2><span class="text-link">Open game →</span></a>}</div>
        @if(_match.TournamentId!=null){<a class="text-link" href="#tournament/@_match.TournamentId">← Back to tournament</a>}
    }
    else if(_page=="account"){
        @if(_session?.User is {} user){<div class="page-heading"><span class="kicker">YOUR ACCOUNT</span><h1>@user.Username</h1><p>@(user.Admin?"Administrator":"Player") · <a href="#player/@user.Username">View profile →</a></p></div><div class="community-columns"><section class="community-card"><h2>Connect your Discord</h2><p>Claim your existing league rating and record with your verified Discord account.</p>
            @if(user.DiscordUsername!=null){<div class="connected-discord"><strong>✓ @user.DiscordUsername</strong><span>@Math.Round(user.LeagueRating) league Elo</span><small>@(user.LeagueClaimed?"Your imported league record is connected.":"Your Discord account is connected.")</small></div>}
            else if(_site!.DiscordEnabled){<form method="post" action="api/auth/discord"><input type="hidden" name="__RequestVerificationToken" value="@_session.CsrfToken"/><button class="community-button discord" type="submit">Connect Discord →</button></form>}
            else{<p class="muted">Discord connection will be available once the site administrator enables it.</p>}
            <p class="muted">New site ratings start at 1500. Your league Elo stays separate.</p></section><section class="community-card"><h2>Account settings</h2><label>Current password<input type="password" autocomplete="current-password" @bind="_oldPassword"/></label><label>New password<input type="password" minlength="12" maxlength="128" autocomplete="new-password" @bind="_newPassword"/></label><button class="small-button" @onclick="ChangePassword">Change password</button><hr/><button class="small-button" @onclick="Logout">Sign out</button>@if(user.Admin){<p><a class="text-link" href="#admin">Administration →</a></p>}</section></div>}
        else{<div class="auth-layout"><div><span class="kicker">A PLACE IN THE MULTIVERSE</span><h1>@(_register?"Make your first move.":"Welcome back.")</h1><p>One account for your matches, studies, messages, and league seasons.</p><div class="auth-benefits"><span>20+ rating pools</span><span>Private studies</span><span>Two-game matches</span></div></div><section class="community-card auth-card"><div class="auth-tabs"><button class="@(!_register?"selected":"")" @onclick="()=>_register=false">Sign in</button><button class="@(_register?"selected":"")" @onclick="()=>_register=true">Create account</button></div><form @onsubmit="Authenticate" @onsubmit:preventDefault><label>Username<input autocomplete="username" required minlength="3" maxlength="24" @bind="_username"/></label><label>Password<input type="password" autocomplete="@(_register?"new-password":"current-password")" required minlength="@(_register?12:1)" maxlength="128" @bind="_password"/></label>@if(_register){<small>Use at least 12 characters. Usernames use letters, numbers, underscores or hyphens.</small>}<button class="community-button primary full" disabled="@_busy">@(_register?"Create account":"Sign in") →</button></form>@if(_site!.DiscordEnabled){<div class="auth-divider">or</div><form method="post" action="api/auth/discord"><input type="hidden" name="__RequestVerificationToken" value="@_session?.CsrfToken"/><button type="submit" class="community-button discord full">Continue with Discord</button></form>}</section></div>}
    }
    else if(_page=="studies"){
        <div class="page-heading heading-actions"><div><span class="kicker">THINK ACROSS TIMELINES</span><h1>Studies</h1><p>Collect games, explore variations, and keep your ideas together.</p></div><button class="community-button primary" @onclick="NewStudy">New study ＋</button></div><div class="study-grid">@foreach(var s in _studies){<a class="community-card study-tile" href="#study/@s.Id"><span class="study-glyph">▧</span><span class="pill">@(s.Public?"Public":"Private")</span><h2>@s.Title</h2><p>@s.Description</p><small>by @s.Owner · @Date(s.Updated)</small></a>}@if(_studies.Length==0){<section class="community-card"><h2>A notebook for every possibility.</h2><p>Create a public study to share, or a private one for your own preparation.</p></section>}</div>
    }
    else if(_page=="study"&&_study!=null){
        <div class="page-heading heading-actions"><div><span class="kicker">@(_study.Public?"PUBLIC":"PRIVATE") STUDY · @_study.Owner</span><h1>@_study.Title</h1></div><a class="text-link" href="#studies">← All studies</a></div>
        @if(_studyAnalysis){<div class="study-toolbar"><button class="small-button" @onclick="()=>_studyAnalysis=false">← Chapter editor</button><span>@_study.Chapters[_chapter].Title</span></div><App @key="_study.Chapters[_chapter].Id" InitialPgn="@_study.Chapters[_chapter].Pgn" SaveStudyPgn="@(OwnStudy?EventCallback.Factory.Create<string>(this,SaveAnalysisChapter):default)"/>}
        else{<div class="study-editor"><aside class="community-card chapter-list"><h2>Chapters</h2>@for(int i=0;i<_study.Chapters.Length;i++){int n=i;<button class="@(n==_chapter?"selected":"")" @onclick="()=>_chapter=n">@(n+1). @_study.Chapters[n].Title</button>}@if(OwnStudy){<button class="text-link" @onclick="AddChapter">＋ Add chapter</button>}</aside><section class="community-card"><div class="form-grid"><label>Study title<input value="@_study.Title" @onchange="e=>_study=_study with {Title=e.Value?.ToString()??string.Empty}" disabled="@(!OwnStudy)" maxlength="100"/></label><label>Visibility<select aria-label="Visibility" value="@(_study.Public?"public":"private")" @onchange='e=>_study=_study with {Public=e.Value?.ToString()=="public"}'  disabled="@(!OwnStudy)"><option value="public">Public</option><option value="private">Private</option></select></label></div><label>Description<textarea value="@_study.Description" @onchange="e=>_study=_study with {Description=e.Value?.ToString()??string.Empty}" disabled="@(!OwnStudy)" maxlength="2000"></textarea></label><label>Chapter title<input value="@_study.Chapters[_chapter].Title" @onchange="e=>EditChapter(title:e.Value?.ToString())" disabled="@(!OwnStudy)" maxlength="100"/></label><label>5DPGN<textarea class="pgn-field" value="@_study.Chapters[_chapter].Pgn" @onchange="e=>EditChapter(pgn:e.Value?.ToString())" disabled="@(!OwnStudy)" spellcheck="false"></textarea></label><label>Notes<textarea value="@_study.Chapters[_chapter].Notes" @onchange="e=>EditChapter(notes:e.Value?.ToString())" disabled="@(!OwnStudy)" maxlength="20000"></textarea></label><div class="button-row"><button class="community-button primary" @onclick="()=>_studyAnalysis=true">Explore on analysis board →</button>@if(OwnStudy){<button class="small-button" disabled="@_busy" @onclick="SaveStudy">Save study</button>@if(_study.Chapters.Length>1){<button class="small-button" @onclick="RemoveChapter">Remove chapter</button>}}</div></section></div>}
    }
    else if(_page=="messages"){
        <div class="page-heading"><span class="kicker">BETWEEN GAMES</span><h1>Messages</h1><p>Arrange a match or talk through a discovery.</p></div>
        @if(_session?.User==null){<section class="community-card"><a href="#account">Sign in to read and send messages →</a></section>}
        else{<div class="messages-layout"><aside class="community-card"><h2>Conversations</h2><label>New conversation<input @bind="_recipient" placeholder="Player’s username" maxlength="24"/></label><button class="small-button" @onclick="OpenConversation">Open →</button><div class="conversation-list">@foreach(var person in _conversations){var p=person;<button class="@(p.UserId==_otherId?"selected":"")" @onclick="()=>Run(()=>LoadConversation(p.UserId,p.Username))"><strong>@p.Username @if(p.Unread>0){<b>@p.Unread</b>}</strong><span>@p.Preview</span></button>}</div></aside><section class="community-card message-panel">@if(_otherId.Length>0){<div class="card-heading"><h2>@_conversationName</h2><button class="small-button" @onclick="ToggleBlock">@(_blocked?"Unblock":"Block")</button></div><div class="message-history">@foreach(var m in _messages){<div class="message-bubble @(m.FromId==_session.User.Id?"mine":"")"><p>@m.Body</p><small>@DateTimeOffset.FromUnixTimeMilliseconds(m.Sent).ToLocalTime().ToString("MMM d · HH:mm")</small></div>}@if(_messages.Length==100){<button class="small-button" @onclick="OlderMessages">Load earlier messages</button>}</div><form class="message-compose" @onsubmit="SendMessage" @onsubmit:preventDefault><textarea placeholder="Write a message…" aria-label="Message" @bind="_messageBody" maxlength="4000" disabled="@_blocked"></textarea><button class="community-button primary" disabled="@(_busy||_blocked)">Send →</button></form>}else{<div class="empty-community"><h2>Your conversations live here.</h2><p>Choose a player to get started.</p></div>}</section></div>}
    }
    else if(_page is "tournaments" or "league"){
        <div class="page-heading heading-actions"><div><span class="kicker">@(_page=="league"?"A SEASON OF POSSIBILITIES":"PLAY FOR SOMETHING")</span><h1>@(_page=="league"?"5D Chess League":"Tournaments")</h1><p>@(_page=="league"?"Round robin groups, arranged by league Elo. Registration and starts are managed by the administrators.":"Round robin, Swiss, knockout, and group stages. Every pairing is two games with colors reversed.")</p></div>@if(_page=="tournaments"||_session?.User?.Admin==true){<button class="community-button primary" @onclick="OpenTournamentForm">@(_page=="league"?"Open a season":"Create tournament") ＋</button>}</div>
        @if(_page=="league"){<div class="league-overview"><div class="community-card"><span>ENTRY LEAGUE</span><strong>Below 1410</strong></div><div class="community-card"><span>ADVANCED LEAGUE</span><strong>1410–1549</strong></div><div class="community-card"><span>PRO LEAGUE</span><strong>1550+</strong></div></div><p class="muted">@(_league?.ImportedPlayers??0) historical players · @(_league?.HistoricalGames??0) archived games · Connect Discord to claim your record. Groups contain up to seven players.</p>}
        @if(_newTournament){<section class="community-card form-card"><h2>@(_leagueForm?"New league season":"New tournament")</h2><div class="form-grid"><label>Name<input @bind="_tournamentName" maxlength="100" placeholder="@(_leagueForm?"Season 4":"Friday night multiverse")"/></label>@if(!_leagueForm){<label>Format<select aria-label="Format" @bind="_format">@foreach(var f in _site!.Formats){<option value="@f">@FormatName(f)</option>}</select></label>}<label>Variant<select aria-label="Variant" @bind="_variant">@foreach(var v in _site!.Variants.Where(v=>v.Available)){<option value="@v.Id">@v.Name</option>}</select></label><label>Minutes per player<input type="number" min="0.5" max="180" step="0.5" @bind="_minutes"/></label><label>Increment (seconds)<input type="number" min="0" max="180" @bind="_increment"/></label><label>Swiss rounds<input type="number" min="1" max="20" @bind="_rounds" disabled="@(_format!="swiss")"/></label><label>Standings scoring<select aria-label="Standings scoring" @bind="_scoring"><option value="game">Game points · win 1, draw ½</option><option value="match">Match points · custom scoring</option></select></label><label>Knockout ties<select aria-label="Knockout ties" @bind="_tieBreak"><option value="seed">Higher pre-tournament seed advances</option><option value="organizer">Organizer decides, with recorded reason</option></select></label></div>@if(_scoring=="match"){<div class="form-grid three"><label>Win<input type="number" min="0" max="100" step="0.5" @bind="_winPoints"/></label><label>Draw<input type="number" min="0" max="100" step="0.5" @bind="_drawPoints"/></label><label>Loss<input type="number" min="0" max="100" step="0.5" @bind="_lossPoints"/></label></div>}<div class="choice-row"><label><input type="checkbox" @bind="_rated"/> Rated</label><label><input type="checkbox" @bind="_private"/> Private invite</label></div><p class="muted">Registration opens immediately. The organizer starts the event when everyone is ready.</p><button class="community-button primary" disabled="@_busy" @onclick="CreateTournament">Open registration →</button></section>}
        <div class="tournament-grid">@foreach(var t in _page=="league"?(_league?.Seasons??[]):_tournaments){<a class="community-card tournament-tile" href="#tournament/@t.Id"><div class="card-heading"><span class="pill @t.Status">@t.Status</span><span>@t.Entrants players</span></div><h2>@t.Name</h2><p>@VariantName(t.Variant) · @(new TimeControl(t.Seconds,t.Increment).Label)</p><div class="tournament-meta"><span>@(t.League?"League groups":FormatName(t.Format))</span><span>2 games / match</span></div><span class="text-link">View tournament →</span></a>}</div>
    }
    else if(_page=="tournament"&&_tournament!=null){
        var t=_tournament.Tournament;
        <div class="page-heading heading-actions"><div><span class="kicker">@(t.League?"5D CHESS LEAGUE":FormatName(t.Format)) · @t.Status</span><h1>@t.Name</h1><p>@VariantName(t.Variant) · @(new TimeControl(t.Seconds,t.Increment).Label) · @(t.Rated?"Rated":"Casual") · @t.Entrants players</p></div><div class="button-row">@if(t.Status=="registration"){<button class="community-button primary" disabled="@_busy" @onclick="JoinTournament">@(t.Joined?"Leave registration":"Join tournament")</button>@if(CanOrganize(t)){<button class="small-button" disabled="@_busy" @onclick="StartTournament">Start tournament →</button>}}<button class="small-button" @onclick='()=>CopyRoute("tournament/"+t.Id)' >Copy invite</button></div></div>
        <div class="tournament-rules"><span>Two games, colors swapped</span><span>@(t.Scoring=="game"?"Game points: 1 / ½ / 0":$"Match points: {t.WinPoints} / {t.DrawPoints} / {t.LossPoints}")</span><span>@(t.TieBreak=="seed"?"Knockout ties: higher seed":"Knockout ties: organizer decision")</span></div>
        @if(CanOrganize(t)&&t.Status=="registration"){<section class="community-card schedule-controls"><label>Optional scheduled start (UTC)<input type="datetime-local" @bind="_scheduledStart"/></label><button class="small-button" @onclick="ScheduleTournament">Schedule start</button><button class="small-button" @onclick="ClearSchedule">Use manual start</button><button class="small-button" @onclick="CancelTournament">Cancel registration</button>@if(t.StartsAt!=null){<span>Scheduled: @DateTimeOffset.FromUnixTimeMilliseconds(t.StartsAt.Value).ToString("u")</span>}</section>}
        <section class="community-card"><div class="card-heading"><h2>Standings</h2><span class="muted">Points · Sonneborn–Berger · Buchholz</span></div><div class="table-scroll"><table><thead><tr><th>Group</th><th>Player</th><th>Points</th><th>Games</th><th>SB</th><th>Buchholz</th></tr></thead><tbody>@foreach(var row in _tournament.Standings){<tr><td>@row.Group</td><td><a href="#player/@row.Username">@row.Username</a></td><td><strong>@row.Points.ToString("0.##")</strong></td><td>@row.GamePoints.ToString("0.#")</td><td>@row.SonnebornBerger.ToString("0.##")</td><td>@row.Buchholz.ToString("0.##")</td></tr>}</tbody></table></div></section>
        <section class="community-card"><div class="card-heading"><h2>Pairings</h2><button class="small-button" @onclick="Refresh">Refresh</button></div><div class="pairing-grid">@foreach(var m in _tournament.Matches){<div class="pairing"><small>Round @m.Round · @m.Group</small><strong>@m.Player1 <span>@m.Score1.ToString("0.#")</span></strong><strong>@m.Player2 <span>@m.Score2.ToString("0.#")</span></strong><div class="button-row">@if(m.Bye){<span class="pill">Bye · no games rated</span>}else{<a class="text-link" href="#match/@m.Id">@m.Status →</a>@if(CanOrganize(t)){<button class="small-button" @onclick="()=>_decisionMatch=m">Manage</button>}}</div></div>}</div></section>
        @if(_decisionMatch is {} decision){<section class="community-card"><h2>Organizer decision</h2><p>@decision.Player1 vs @decision.Player2 · Exactly two games; a tie-break does not add a third.</p><label>Player to advance / win by forfeit<select @bind="_decisionWinner"><option value="">Choose player</option><option value="@decision.Player1Id">@decision.Player1</option><option value="@decision.Player2Id">@decision.Player2</option></select></label><label>Reason (recorded in the audit log)<textarea @bind="_decisionReason" minlength="10" maxlength="1000"></textarea></label><button class="small-button" @onclick="ResolveMatch">@(decision.Status=="finished"?"Resolve tied match":"Forfeit remaining games")</button></section>}
    }
    else if(_page=="players"){
        <div class="page-heading"><span class="kicker">FIND YOUR RIVALS</span><h1>Players & ratings</h1><p>Glicko-2 ratings are separate for every variant and time category. New ratings begin at 1500.</p></div><section class="community-card"><div class="form-grid"><label>Find a player<input @bind="_playerSearch" placeholder="Username"/></label><button class="small-button" @onclick="FindPlayer">View profile →</button><label>Variant<select aria-label="Variant" @bind="_leaderVariant" @bind:after="LoadLeaderboard">@foreach(var v in _site!.Variants.Where(v=>v.Available)){<option value="@v.Id">@v.Name</option>}</select></label><label>Rating<select aria-label="Rating" @bind="_leaderCategory" @bind:after="LoadLeaderboard"><option>bullet</option><option>blitz</option><option>rapid</option><option>classical</option><option value="league">League Elo</option></select></label></div><table><thead><tr><th>#</th><th>Player</th><th>Rating</th><th>Games</th></tr></thead><tbody>@for(int i=0;i<_leaders.Length;i++){var p=_leaders[i];<tr><td>@(i+1)</td><td><a href="#player/@p.Username">@p.Username</a></td><td>@Math.Round(p.Rating)@(p.Deviation>110?"?":"")</td><td>@p.Games</td></tr>}</tbody></table>@if(_leaders.Length==0){<p class="muted">No rated games in this pool yet.</p>}</section>
    }
    else if(_page=="player"&&_profile!=null){
        <div class="page-heading heading-actions"><div><span class="kicker">PLAYER PROFILE</span><h1>@_profile.User.Username</h1><p>League Elo @Math.Round(_profile.User.LeagueRating) · @_profile.LeagueWins W / @_profile.LeagueDraws D / @_profile.LeagueLosses L</p></div><div class="button-row"><button class="community-button primary" @onclick="ChallengePlayer">Challenge →</button><button class="small-button" @onclick="MessagePlayer">Message</button></div></div><section class="community-card"><h2>Ratings by variant</h2><div class="table-scroll"><table><thead><tr><th>Variant</th><th>Bullet</th><th>Blitz</th><th>Rapid</th><th>Classical</th></tr></thead><tbody>@foreach(var group in _profile.Ratings.GroupBy(r=>r.Variant)){<tr><td>@VariantName(group.Key)</td>@foreach(var r in group){<td>@Math.Round(r.Rating)@(r.Deviation>110?"?":"")<small class="rating-games">@r.Games games</small></td>}</tr>}</tbody></table></div><p class="muted">? means provisional. Rating deviation decreases as more games are played.</p></section>
    }
    else if(_page=="admin"){
        <div class="page-heading"><span class="kicker">ADMINISTRATION</span><h1>Site activity</h1><p>League starts, account claims, reports, and organizer decisions.</p></div><section class="community-card"><h2>Moderation</h2><div class="form-grid"><label>Player ID<input @bind="_moderateId"/></label><label>Reason<input @bind="_moderateReason" minlength="10"/></label></div><div class="button-row"><button class="small-button" @onclick="()=>Suspend(true)">Suspend account</button><button class="small-button" @onclick="()=>Suspend(false)">Restore account</button></div><hr/><div class="audit-list">@foreach(var entry in _audit){<article><strong>@entry.Action</strong><small>@Date(entry.At) · @entry.Subject</small><p>@entry.Detail</p></article>}</div></section>
    }
    else if(!_loading){<section class="community-card"><h1>Page not found</h1><a href="#play">Return to play →</a></section>}
    </main>}
    <footer class="community-footer"><span>SKYNETZERO <small>· A home for 5D chess</small></span><a href="#bot">Engine & analysis</a><a href="https://github.com/CrazyPenguin0111/skynet-zero-web" target="_blank" rel="noreferrer">Open source ↗</a></footer>
</div>
}
